*.swo

# Git
.git/
.gitignore

# Node (frontend is a separate service)
frontend/node_modules/
frontend/.next/

# Environment files — never bake secrets into image
.env
.env.*
!.env.example

# Office docs
*.docx
*.xlsx
*.pptx

