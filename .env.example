# AWS Financial Services Assistant -- Environment Variables
# Copy this file to .env and fill in your credentials
#
# REQUIRED:
#   1. ANTHROPIC_API_KEY   -- from console.anthropic.com/settings/keys
#   2. DATABASE_URL        -- PostgreSQL with pgvector extension
#   3. TAVILY_API_KEY      -- from app.tavily.com (for Discovery Briefs)
#
# On Railway: DATABASE_URL is injected automatically by the PostgreSQL plugin.
# Do NOT add DATABASE_URL manually on Railway.

# Anthropic (required) -- Powers all three agents
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# PostgreSQL + pgvector (required) -- local development example
# Railway injects this automatically -- do not set manually on Railway
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/aws_finserv

# Tavily Web Search (required for Discovery Briefs)
# Get key: https://app.tavily.com (free tier: 1,000 searches/month)
TAVILY_API_KEY=tvly-your-key-here
