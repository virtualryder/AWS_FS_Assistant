FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for psycopg2, lxml, and pdfplumber
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-api.txt .

# Install CPU-only PyTorch first to avoid the ~2 GB GPU build that
# sentence-transformers pulls in by default. This keeps the image under 2 GB.
RUN pip install --no-cache-dir \
    torch==2.5.1+cpu \
    --extra-index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir -r requirements-api.txt

# Copy project source
COPY . .

EXPOSE 8000

# Copy and use start.sh as the entrypoint so uvicorn runs as PID 1.
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh

CMD ["/app/start.sh"]
