FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for psycopg2, lxml, and pdfplumber
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libxml2-dev \
    libxslt-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copy project source
COPY . .

EXPOSE ${PORT:-8000}

# workers=1 is required — SessionStore is in-process memory.
# Shell form is used so that $PORT is expanded at container start time.
# Railway injects $PORT; falls back to 8000 for local docker run.
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1
